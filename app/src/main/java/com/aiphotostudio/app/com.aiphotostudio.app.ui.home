private data class AiTool(val emoji: String, val name: String, val desc: String, val cost: Int)
private data class FreeTool(val emoji: String, val name: String)

// Costs are placeholders; final prices depend on your real AI processing cost.
private val aiTools = listOf(
    AiTool("✨", "AI Enhancer", "Sharpen and restore detail", 5),
    AiTool("✂️", "Background Remover", "Cut out the subject", 8),
    AiTool("🏞️", "Background Changer", "Put the subject in a new scene", 10),
    AiTool("🧽", "Object Eraser", "Remove unwanted objects", 8),
    AiTool("🎨", "AI Effects", "Artistic styles and looks", 6)
)
private val freeTools = listOf(
    FreeTool("🎞️", "Filters"), FreeTool("✂", "Crop"), FreeTool("📐", "Resize")
)

@Composable
fun HomeScreen(balance: Int, isPremium: Boolean) {
    val ctx = LocalContext.current
    val scope = rememberCoroutineScope()
    val snack = remember { SnackbarHostState() }
    var photo by remember { mutableStateOf<ImageBitmap?>(null) }

    fun say(msg: String) {
        scope.launch {
            snack.currentSnackbarData?.dismiss()
            snack.showSnackbar(msg)
        }
    }

    val picker = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
        if (uri != null) scope.launch { photo = withContext(Dispatchers.IO) { decodeScaled(ctx, uri) } }
    }

    Scaffold(containerColor = Palette.Black, snackbarHost = { SnackbarHost(snack) }) { pad ->
        Column(
            Modifier.padding(pad).verticalScroll(rememberScrollState())
                .padding(horizontal = 16.dp, vertical = 8.dp),
            verticalArrangement = Arrangement.spacedBy(22.dp)
        ) {
            TopBar(balance, isPremium) { say("Earning credits with ads arrives in step 4.") }
            Hero(photo) {
                picker.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly))
            }
            Section("Free tools") {
                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                    freeTools.forEach { t ->
                        FreeCard(t, Modifier.weight(1f)) {
                            say("${t.name} opens in the editor (step 2). No credits needed.")
                        }
                    }
                }
            }
            Section("AI tools") {
                aiTools.chunked(2).forEach { row ->
                    Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                        row.forEach { t ->
                            AiCard(t, Modifier.weight(1f)) {
                                say("${t.name} costs ${t.cost} credits. AI processing arrives in step 6.")
                            }
                        }
                        if (row.size == 1) Spacer(Modifier.weight(1f))
                    }
                }
            }
            EarnCard { say("Rewarded ads arrive in step 4.") }
            PremiumBanner { say("Subscriptions arrive in step 5.") }
            Spacer(Modifier.height(16.dp))
        }
    }
}

@Composable
private fun TopBar(balance: Int, isPremium: Boolean, onCredits: () -> Unit) {
    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
        Column {
            Text("AI Photo Studio", color = Palette.Text, fontSize = 22.sp, fontWeight = FontWeight.Bold)
            Text(if (isPremium) "Premium member" else "Free plan", color = Palette.Muted, fontSize = 12.sp)
        }
        Row(
            Modifier.clip(RoundedCornerShape(50)).background(Palette.Surface)
                .border(1.dp, Palette.Purple, RoundedCornerShape(50))
                .clickable(onClick = onCredits).padding(horizontal = 14.dp, vertical = 8.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            Text("🪙", fontSize = 16.sp)
            Text("$balance", color = Palette.Text, fontSize = 17.sp, fontWeight = FontWeight.Bold)
            Text("+", color = Palette.Purple, fontSize = 18.sp, fontWeight = FontWeight.Bold)
        }
    }
}

@Composable
private fun Hero(photo: ImageBitmap?, onPick: () -> Unit) {
    Column(
        Modifier.fillMaxWidth().clip(RoundedCornerShape(24.dp))
            .background(Brush.linearGradient(listOf(Palette.PurpleDeep, Color(0xFF2E1065), Palette.Black)))
            .padding(20.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        Text("Edit like a pro", color = Color.White, fontSize = 26.sp, fontWeight = FontWeight.Bold)
        Text("Free editing tools and AI magic in one place.", color = Palette.PurpleSoft, fontSize = 14.sp)
        if (photo != null) {
            Image(
                bitmap = photo, contentDescription = "Selected photo", contentScale = ContentScale.Crop,
                modifier = Modifier.fillMaxWidth().height(190.dp).clip(RoundedCornerShape(16.dp))
            )
        }
        Button(
            onClick = onPick, shape = RoundedCornerShape(14.dp),
            colors = ButtonDefaults.buttonColors(containerColor = Color.White, contentColor = Palette.PurpleDeep),
            modifier = Modifier.fillMaxWidth().height(50.dp)
        ) { Text(if (photo == null) "Open a photo" else "Choose another photo", fontWeight = FontWeight.Bold) }
    }
}

@Composable
private fun Section(title: String, content: @Composable ColumnScope.() -> Unit) {
    Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
        Text(title, color = Palette.Text, fontSize = 17.sp, fontWeight = FontWeight.SemiBold)
        content()
    }
}

@Composable
private fun FreeCard(t: FreeTool, modifier: Modifier, onClick: () -> Unit) {
    val shape = RoundedCornerShape(16.dp)
    Column(
        modifier.clip(shape).background(Palette.Surface).border(1.dp, Palette.Line, shape)
            .clickable(onClick = onClick).padding(vertical = 16.dp),
        horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(4.dp)
    ) {
        Text(t.emoji, fontSize = 26.sp)
        Text(t.name, color = Palette.Text, fontSize = 13.sp, fontWeight = FontWeight.Medium)
        Text("Free", color = Palette.PurpleSoft, fontSize = 11.sp)
    }
}

@Composable
private fun AiCard(t: AiTool, modifier: Modifier, onClick: () -> Unit) {
    val shape = RoundedCornerShape(18.dp)
    Column(
        modifier.clip(shape).background(Palette.Surface).border(1.dp, Palette.Line, shape)
            .clickable(onClick = onClick).padding(14.dp),
        verticalArrangement = Arrangement.spacedBy(6.dp)
    ) {
        Text(t.emoji, fontSize = 30.sp)
        Text(t.name, color = Palette.Text, fontSize = 15.sp, fontWeight = FontWeight.SemiBold)
        Text(t.desc, color = Palette.Muted, fontSize = 12.sp, lineHeight = 16.sp)
        Spacer(Modifier.height(2.dp))
        Text(
            "🪙 ${t.cost} credits", color = Palette.Gold, fontSize = 11.sp, fontWeight = FontWeight.Medium,
            modifier = Modifier.clip(RoundedCornerShape(50)).background(Palette.Surface2)
                .padding(horizontal = 9.dp, vertical = 3.dp)
        )
    }
}

@Composable
private fun EarnCard(onClick: () -> Unit) {
    val shape = RoundedCornerShape(18.dp)
    Row(
        Modifier.fillMaxWidth().clip(shape).background(Palette.Surface2)
            .border(1.dp, Palette.Purple.copy(alpha = 0.5f), shape).clickable(onClick = onClick).padding(16.dp),
        verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(14.dp)
    ) {
        Text("🎬", fontSize = 28.sp)
        Column(Modifier.weight(1f)) {
            Text("Earn free credits", color = Palette.Text, fontWeight = FontWeight.SemiBold)
            Text("Watch a short ad, get 10 credits", color = Palette.Muted, fontSize = 12.sp)
        }
        Text("+10", color = Palette.Gold, fontWeight = FontWeight.Bold, fontSize = 18.sp)
    }
}

@Composable
private fun PremiumBanner(onClick: () -> Unit) {
    Row(
        Modifier.fillMaxWidth().clip(RoundedCornerShape(18.dp))
            .background(Brush.horizontalGradient(listOf(Palette.Purple, Palette.PurpleDeep)))
            .clickable(onClick = onClick).padding(16.dp),
        verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(14.dp)
    ) {
        Text("👑", fontSize = 28.sp)
        Column(Modifier.weight(1f)) {
            Text("Go Premium", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 16.sp)
            Text("Monthly bonus credits and pro tools", color = Color.White.copy(alpha = 0.8f), fontSize = 12.sp)
        }
        Text("View", color = Color.White, fontWeight = FontWeight.SemiBold)
    }
}

private fun decodeScaled(ctx: Context, uri: Uri, max: Int = 1024): ImageBitmap? = try {
    val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
    ctx.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
    var sample = 1
    while (bounds.outWidth / sample > max || bounds.outHeight / sample > max) sample *= 2
    val opts = BitmapFactory.Options().apply { inSampleSize = sample }
    ctx.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, opts) }?.asImageBitmap()
} catch (e: Exception) {
    null
}
